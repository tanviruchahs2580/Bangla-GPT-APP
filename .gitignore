# ============================================================
# Bangla GPT APP - baseline .gitignore
# Technology-agnostic baseline. Extend per-stack once the
# application technology stack is selected.
# ============================================================

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets.*
credentials.*
service-account*.json

# --- OS metadata ---
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# --- IDE / editor metadata ---
.idea/
.vscode/
*.swp
*.swo

# --- Logs & temporary files ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# --- Build output & caches ---
build/
dist/
out/
target/
coverage/
.cache/
.npm/
.pip/

# --- Dependency directories ---
node_modules/
vendor/

# --- Python ---
__pycache__/
.venv/
venv/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Local databases & large local artifacts ---
*.sqlite
*.sqlite3
*.db
models/
*.onnx
*.gguf

# --- Generated evaluation artifacts (regenerable via scripts/evaluate_golden.py) ---
apps/api/eval/golden_report.json

# --- NCTB corpus content (copyrighted textbooks; provenance stays in git) ---
data/nctb/raw/
data/nctb/extracted/
data/nctb/normalized/

# --- Local live-testing evidence (screenshots, not for repo) ---
live_evidence/
