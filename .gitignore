# ============================================================
# Bangla GPT APP - baseline .gitignore
# Technology-agnostic baseline. Extend per-stack once the
# application technology stack is selected.
# ============================================================

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
# Android upload-key config (Play Store): the property file names the keystore
# path and carries its passwords. The example file is the committed template.
keystore.properties
secrets.*
credentials.*
service-account*.json

# --- OS metadata ---
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# --- IDE / editor metadata ---
.idea/
.vscode/
*.swp
*.swo

# --- Logs & temporary files ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# --- Build output & caches ---
build/
dist/
out/
target/
coverage/
.cache/
.npm/
.pip/

# --- Dependency directories ---
node_modules/
vendor/

# --- Python ---
__pycache__/
.venv/
venv/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Local databases & large local artifacts ---
*.sqlite
*.sqlite3
*.db
# F-011: `*.db` does not match a copy whose name carries a suffix, and SQLite
# writes three sidecar files that do not end in `.db` at all. That gap is how
# a 1.30 MiB database with 129 user rows and 376 chat rows reached history
# (F-012) -- it was committed as `dev.db.bak-wave2`, a path nothing ignored.
# Verified with `git check-ignore` before and after.
*.db-*
*.db.*
*.db.bak-*
*.db-wal
*.db-shm
*.db-journal
# Same three sidecars for the other SQLite spellings.
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
# Vendored model weights live at the repository root (`/models`), not in any
# source package: a bare `models/` also ignored `bangla_gpt_api/db/models/`
# once that module became a package (caught by the CI eval gate: the package
# was absent from the pushed tree).
/models/
*.onnx
*.gguf

# --- Generated evaluation artifacts (regenerable via scripts/evaluate_golden.py) ---
apps/api/eval/golden_report.json

# --- NCTB corpus content (copyrighted textbooks; provenance stays in git) ---
data/nctb/raw/
data/nctb/extracted/
data/nctb/normalized/

# --- Local live-testing evidence (screenshots, not for repo) ---
live_evidence/

# Local live-QA working directory (openapi snapshots, role scripts, backups)
# -- the QA record that matters lives in docs/qa/, not in this scratch dir.
.qa-deploy/

# --- Local tooling / test artifacts (not for repo) ---
.zcodeignore
.zcode/
apps/api/.coverage
.coverage

# --- Local SMTP sink (mailpit) TLS cert/key — never commit ---
.mailpit/

.vercel

# Audit run screenshots: large local QA evidence (26MB+). Regenerate with the
# app running; the reports in docs/audit-*/ are the durable record.
docs/audit-*/screenshots/

# --- Mutation testing (E-04): mutmut's scratch tree and cache are local
# artifacts, regenerated by the documented container recipe; only the score
# and its evidence are committed. ---
apps/api/mutants/
apps/api/.mutmut-cache/
.mutmut-cache/
