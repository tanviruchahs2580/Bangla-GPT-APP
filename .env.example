# Bangla GPT APP — environment template
# Copy to .env for local development. NEVER commit a real .env.
# This file documents EVERY Settings field (enforced by tests/test_env_example.py).

ENV=development
LLM_PROVIDER=mock                    # mock | gemini

# Service identity (rarely overridden):
# APP_NAME=Bangla GPT API
# VERSION=   # never set: the reported version is read from apps/api/pyproject.toml

# ── LLM: Gemini provider ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite   # new-format ("AQ.") keys cannot use gemini-2.5-flash
# GEMINI_FAST_MODEL=   # S4.2 router: model for SIMPLE routes (empty = main model serves all)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Hard ceiling on generated completion size (0 = no cap; key omitted from provider payload)
LLM_MAX_OUTPUT_TOKENS=2048
# LLM_FALLBACK_PROVIDER=   # Secondary provider for auto-fallback (e.g. "gemini" or "openai"; empty = no fallback)
# AI-002: monthly per-user AI budget in USD (estimated metering). 0 = unlimited.
# AI_MONTHLY_BUDGET_USD_PER_USER=0
# F-031: false = tutor/chat generation refuses (ai_generation_disabled) while
# retrieval/search/reader/quizzes keep working; true (default) = normal.
AI_GENERATION_ENABLED=true
# RAG-27: true = when the provider is unavailable, tutoring surfaces answer
# with the retrieved textbook excerpts + citations (explicitly ungrounded,
# refused_reason=provider_unavailable) instead of a 502 llm_unavailable.
RETRIEVAL_ONLY_FALLBACK_ENABLED=false

# ── OpenAI-compatible provider ─────────────────────────────────────────────
# Support both official OpenAI and OpenAI-compatible APIs (OpenRouter, Together, Ollama).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # Override to a compatible endpoint (defaults to api.openai.com)

# ── Circuit breaker (AI resilience) ────────────────────────────────────────
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=3    # consecutive failures before opening the circuit
# CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=60  # seconds before probing the primary again

# ── LLM provider data-use terms (PRIV-06) ──────────────────────────────────
# Which tier the configured provider key belongs to: unset | free | paid.
# The vendor's free tier uses submitted content to improve its products; a
# production boot with LLM_DATA_USE_TIER=free refuses until the terms have
# been looked up and recorded (docs/playstore/data-safety.md, open item 1)
# and the acknowledgement below is set. "unset" is not refused -- confirming
# the tier is an owner action.
LLM_DATA_USE_TIER=unset
# Set true only once the tier's data-use/retention terms are recorded with a date.
LLM_DATA_USE_ACKNOWLEDGED=false

# ── RAG v2 retrieval (S4.3) ──────────────────────────────────────────────
# hybrid = BM25 + vector lanes fused (RRF) + rerank; bm25 = v1 lexical only
RETRIEVAL_MODE=hybrid
# EMBEDDING_MODEL=   # real multilingual model = staging human input; empty = deterministic local vector lane

# ── Persistence ──────────────────────────────────────────────────────────
# SQLite file DB for local development (default is sqlite:///./bangla_gpt.db):
# DATABASE_URL=sqlite:///./bangla_gpt.db
# Postgres (requires the [postgres] extra):
# DATABASE_URL=postgresql+psycopg://bgpt:bgpt@localhost:5432/bgpt

# ── Auth ─────────────────────────────────────────────────────────────────
# JWT signing secret — MUST be overridden with >=32 random chars in any shared
# or deployed environment. Production boot refuses the default.
# JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=30
# SEC-02: length floor of the password policy (NIST SP 800-63B-4 s3.1.1.2,
# cited in auth/security.py). 8 is the documented product contract and the
# figure the policy allows where the password is one factor of MFA; the
# policy requires 15 for single-factor passwords, so raise this to 15 when
# MFA is not mandatory. Length is the only structural rule -- there are no
# composition requirements, and passphrases up to 128 characters are kept.
PASSWORD_MIN_LENGTH=8
# SEC-02/F-143: what POST /auth/register answers for an address that already
# exists. disclose (default) keeps the documented 409 email_taken -- signup
# gets an immediate answer, at the cost of an unauthenticated enumeration
# oracle. generic answers 202 {"status":"accepted"} for a new and a taken
# address alike (the taken one creates nothing, logged server-side) and
# closes the oracle; that mode expects SMTP delivery configured and a client
# that is not relying on the 201 auto-login body. The trade-off is recorded
# in docs/security/threat-model.md; it is an owner decision per deployment.
REGISTRATION_EMAIL_CONFLICT=disclose
# Claim bindings verified on every token (SEC-03). Change these only if another
# service must consume these tokens, and give that service its own pair.
JWT_ISSUER=bangla-gpt-api
JWT_AUDIENCE=bangla-gpt-clients

# Bootstrap admin — created at startup ONLY if both are set and no admin exists.
# In production both are REQUIRED and ADMIN_PASSWORD must be >=12 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Force password rotation on first admin login (secure default).
FORCE_ADMIN_PASSWORD_CHANGE=true

# ── HTTP hardening / CORS ────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
# APK (Capacitor WebView) origins — add BOTH before shipping an APK, or its
# login calls fail CORS preflight. The WebView cannot use the relative
# '/api' base either: release builds MUST set
# VITE_API_BASE=https://<stable-api-host>/api (see docs/mobile_release.md).
# Example: ALLOWED_ORIGINS=https://bangla-gpt-app.vercel.app,capacitor://localhost,https://localhost
# Request-body ceiling. 4 MB fits the wave-2 vision contract (up to ~2 MB of
# base64 image JSON per chat turn); a smaller value makes the middleware 413
# valid image turns. DATA-001: compose default aligned to the same value.
MAX_BODY_BYTES=4000000

# ── Rate limiting (login/forgot: per IP; tutor: per user when signed in) ─
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=30
RATE_LIMIT_TUTOR_IP_PER_MINUTE=60     # IP ceiling for other /tutor/* routes
RATE_LIMIT_BACKEND=memory            # memory | redis
RATE_LIMIT_FAIL_OPEN=false           # true = allow traffic when Redis is down
REDIS_URL=

# RATE_LIMIT_RULES=   # JSON per-route limits, e.g. {"/quizzes": [30, "user"]}.
#                     # Applies to every route EXCEPT /auth/login, /tutor/ask,
#                     # /tutor/conversations, /tutor — those four are governed
#                     # by the RATE_LIMIT_*_PER_MINUTE knobs above.

# S5.4 scheduled jobs (parent weekly digest, nightly weakness rollup).
# inline = the web process runs them (single-process dev); arq = offload to
# the ARQ worker (docker compose --profile worker). Both claim periods in the
# job_runs table, so a mixed setup can never send the same email twice.
JOBS_BACKEND=inline                    # inline | arq

# ── Chat ─────────────────────────────────────────────────────────────────
# prior turns sent as context per reply
CHAT_HISTORY_MESSAGES=8
# Per-message char cap when past turns are replayed into the prompt
CHAT_HISTORY_MESSAGE_CHAR_LIMIT=2000
# conversations older are purged
CHAT_RETENTION_DAYS=180
# Product analytics trail (analytics_events). The table is swept on the same
# schedule; the account-erasure path also drops the user_id attribution.
ANALYTICS_RETENTION_DAYS=180
# DB-04: the graded-answer record and the AI spend ledger now age on their
# own clocks (backfilled from the attempt for pre-existing rows). Two school
# years for the academic record; one year for the spend ledger (the budget
# math reads only the current month).
ANSWER_LOG_RETENTION_DAYS=730
AI_USAGE_RETENTION_DAYS=365
# F-007: finished AI jobs (ready|failed) age out; in-flight rows never do.
AI_JOBS_RETENTION_DAYS=30

# ── AI job lifecycle (F-007) ─────────────────────────────────────────────
# Total runner executions for one POST /teacher/jobs job (>=1); transient
# provider failures retry with the backoff below, caller-fixable failures
# fail on the first attempt.
AI_JOB_MAX_ATTEMPTS=3
# First backoff delay in seconds; doubles per attempt, capped at 4s.
AI_JOB_RETRY_BACKOFF_SECONDS=0.5
# How long an Idempotency-Key header on POST /teacher/jobs stays replayable.
AI_JOB_IDEMPOTENCY_WINDOW_MINUTES=1440

# ── Parent invites ───────────────────────────────────────────────────────
INVITE_TTL_MINUTES=1440
# Legacy bare-ID parent linking (insecure; invite-code flow is the default)
ALLOW_DIRECT_PARENT_LINK=false

# Trust X-Forwarded-For for IP-scoped rate limits. The compose stack ships
# true, which is safe ONLY because the bundled Caddy OVERWRITES the header
# with its observed peer (`header_up X-Forwarded-For {remote_host}`); the
# limiter reads the LAST valid XFF entry (S-001). Behind an APPENDING proxy
# (nginx $proxy_add_x_forwarded_for, Caddy's default), or with any second
# untrusted hop, set this false: spoofed elements would otherwise let a
# caller choose its own rate-limit bucket. Non-IP entries are ignored and
# the transport peer is used instead.
# apps/api/scripts/check_proxy_contract.py fails CI if this pairing drifts.
TRUST_PROXY_HEADERS=false

# Fernet key for guardian phone encryption at rest (S5.6). Leave blank in
# development: phone is then stored as plaintext -- but only while
# PII_ALLOW_PLAINTEXT (below) stays true. Production refuses to boot with
# either a blank key or plaintext allowed. Generate a key with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Treat it like JWT_SECRET: secret store only, never commit the value.
PII_ENC_KEY=
# Audit B-04: the old behaviour silently stored guardian phones unencrypted
# whenever the key was missing. The choice is now explicit: set this to
# false (with a real PII_ENC_KEY) anywhere child-guardian PII matters; a
# write then fails with a coded 503 instead of storing PII in the clear.
PII_ALLOW_PLAINTEXT=true

# ── Email delivery (password reset) ──────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ANON-06: true (default) refuses a relay that does not speak STARTTLS (reset
# and verification codes must not cross a cleartext wire); false is for a
# local sink without a certificate (mailpit on 1025), which then upgrades
# opportunistically when the relay advertises STARTTLS.
SMTP_REQUIRE_STARTTLS=true

# Parent weekly digest (S3.4): Sunday ~22:00 Dhaka, once per week.
# Bodies carry summary aggregates only -- never conversation content.
PARENT_DIGEST_ENABLED=true
PARENT_DIGEST_CHECK_MINUTES=60

# Nightly weakness reconciliation (S4.6): daily ~03:00 Dhaka, recomputes
# per-concept mastery rows from the graded answer log (counts only).
WEAKNESS_REFRESH_ENABLED=true
WEAKNESS_REFRESH_CHECK_MINUTES=60

# ── Data ─────────────────────────────────────────────────────────────────
# Directory with the built NCTB corpus (normalized/ + quality_report.json).
NCTB_CORPUS_DIR=
# F-016: with NCTB_CORPUS_DIR empty the tutor falls back to the bundled
# synthetic sample corpus. Production refuses that fallback when a billable
# LLM provider is configured unless this opt-in is set (offline demos only).
# ALLOW_BUNDLED_SAMPLE_CORPUS_IN_PRODUCTION=false

# ── Observability ────────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
SENTRY_DSN=                          # https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENV=development
METRICS_REQUIRE_AUTH=false
METRICS_TOKEN=
# Production MUST set METRICS_REQUIRE_AUTH=true plus a METRICS_TOKEN value
# (boot refuses otherwise — SEC-001, enforced by enforce_production_safety).
