# Bangla GPT APP — environment template
# Copy to .env for local development. NEVER commit a real .env.
# This file documents EVERY Settings field (enforced by tests/test_env_example.py).

ENV=development
LLM_PROVIDER=mock                    # mock | gemini

# Service identity (rarely overridden):
# APP_NAME=Bangla GPT API
# VERSION=0.2.0

# ── LLM: Gemini provider ─────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite   # new-format ("AQ.") keys cannot use gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ── Persistence ──────────────────────────────────────────────────────────
# SQLite file DB for local development (default is in-memory):
# DATABASE_URL=sqlite:///./bangla_gpt.db
# Postgres (requires the [postgres] extra):
# DATABASE_URL=postgresql+psycopg://bgpt:bgpt@localhost:5432/bgpt

# ── Auth ─────────────────────────────────────────────────────────────────
# JWT signing secret — MUST be overridden with >=32 random chars in any shared
# or deployed environment. Production boot refuses the default.
# JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=30

# Bootstrap admin — created at startup ONLY if both are set and no admin exists.
# In production both are REQUIRED and ADMIN_PASSWORD must be >=12 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Force password rotation on first admin login (secure default).
FORCE_ADMIN_PASSWORD_CHANGE=true

# ── HTTP hardening / CORS ────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173
MAX_BODY_BYTES=65536

# ── Rate limiting (login/forgot: per IP; tutor: per user when signed in) ─
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=30
RATE_LIMIT_TUTOR_IP_PER_MINUTE=60     # IP ceiling for other /tutor/* routes
RATE_LIMIT_BACKEND=memory            # memory | redis
RATE_LIMIT_FAIL_OPEN=false           # true = allow traffic when Redis is down
REDIS_URL=

# ── Chat ─────────────────────────────────────────────────────────────────
CHAT_HISTORY_MESSAGES=8              # prior turns sent as context per reply
CHAT_RETENTION_DAYS=180              # conversations older are purged

# ── Parent invites ───────────────────────────────────────────────────────
INVITE_TTL_MINUTES=
# Legacy bare-ID parent linking (insecure; invite-code flow is the default)
ALLOW_DIRECT_PARENT_LINK=false1440

# ── Email delivery (password reset) ──────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Data ─────────────────────────────────────────────────────────────────
# Directory with the built NCTB corpus (normalized/ + quality_report.json).
NCTB_CORPUS_DIR=

# ── Observability ────────────────────────────────────────────────────────
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
