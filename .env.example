# Bangla GPT APP - environment template
# Copy to .env for local development. NEVER commit the real .env.

APP_ENV=development
LLM_PROVIDER=mock

# SQLite file DB for local development (default is in-memory):
# DATABASE_URL=sqlite:///./bangla_gpt.db

# JWT signing secret - MUST be overridden with a long random value in any
# shared/deployed environment. The default exists for local dev only.
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=60

# Rate limiting (per client IP, in-memory, per process):
# RATE_LIMIT_LOGIN_PER_MINUTE=10
# RATE_LIMIT_TUTOR_PER_MINUTE=30
# MAX_BODY_BYTES=65536

# Bootstrap admin - created at startup ONLY if both are set and no admin exists:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Future providers (placeholders only until implemented):
# GEMINI_API_KEY=
# OPENAI_API_KEY=
