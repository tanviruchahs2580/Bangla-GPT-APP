# Bangla GPT APP - environment template
# Copy to .env for local development. NEVER commit the real .env.

APP_ENV=development
LLM_PROVIDER=mock

# SQLite file DB for local development (default is in-memory):
# DATABASE_URL=sqlite:///./bangla_gpt.db

# JWT signing secret - MUST be overridden with a long random value in any
# shared/deployed environment. The default exists for local dev only.
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=60

# Future providers (placeholders only until implemented):
# GEMINI_API_KEY=
# OPENAI_API_KEY=
