{
  // cspell configuration (audit finding J-10: markdown quality).
  //
  // Decision: spell-check the English prose with cspell, offline, from this
  // committed word list. The alternative (skip the check and document why) was
  // rejected: the docs are the product's front door for schools and operators,
  // and a typo in a command or a term is a defect a machine catches for free.
  //
  // Bangla is deliberately out of scope: the repository is Bangla-first, so
  // Bengali-script runs are exempt below, and Bangla wording is reviewed
  // through the native-review process (docs/native-review-sheet.md), not by a
  // spell checker. Banglish transliterations that appear in prose
  // (bhitore, bhagnangsho, kosh, ...) are project vocabulary and are listed.
  //
  // Run: npx --yes cspell@9 --no-progress "**/*.md"
  // CI wiring lives in .audit/handoffs/workflows-j2.md (workflow files are
  // owned by the ci tag).
  //
  // Maintenance: when a new tool, product or transliterated term enters the
  // docs, add it here in the same pull request. The list is explicit rather
  // than pattern-based on purpose, so a typo in any *other* word still fails.
  "version": "0.2",
  "language": "en",
  "languageSettings": [
    {
      // The repository writes British English ("licence", "behaviour",
      // "minimisation"); the lowercase "en-gb" is the dictionary name cspell
      // accepts (a wrong-case name is silently ignored, so do not "fix" it).
      "languageId": "markdown",
      "locale": "en-gb"
    },
    {
      // NCTB_DATA_PIPELINE.md quotes a legacy-Bijoy mojibake sample
      // ("wkÿvµg"): the token is evidence of the encoding defect the pipeline
      // fixes, not a word, so it is exempt in that file only.
      "filename": "**/docs/NCTB_DATA_PIPELINE.md",
      "ignoreRegExpList": ["/[A-Za-z\\u00a0-\\u00ff]*[\\u00b5\\u00ff]+[A-Za-z\\u00a0-\\u00ff]*/g"]
    }
  ],
  "dictionaries": ["en-gb", "companies", "softwareTerms", "python", "node", "npm", "bash", "docker"],
  "ignoreRegExpList": [
    // Bengali script (U+0980–U+09FF) and its digits: reviewed natively, not here.
    "/[\\u0980-\\u09FF]+/g",
    // Acronym-expansion table rows are written "| **L**inkability |" (LINDDUN,
    // STRIDE); the bold label letter is a table device, so the word glued to
    // it is not checked.
    "/(?<=[*][*][A-Za-z][*][*])[a-z]+/g"
  ],
  "ignorePaths": [
    // Not living prose: generated, vendored, point-in-time or machine output.
    "node_modules/**",
    ".venv/**",
    "**/node_modules/**",
    "CHANGELOG.md",
    "docs/API.md",
    "docs/archive/**",
    "docs/audit/**",
    "docs/qa/**",
    "docs/native-review/**",
    "docs/native-review-sheet.md",
    "docs/uiux_renovation_evidence/**",
    "docs/evaluation/**",
    ".audit/**",
    ".audit-work/**",
    ".qa-deploy/**",
    "apps/web/coverage/**",
    "**/package-lock.json",
    "**/LICENSE*",
    "**/THIRD_PARTY_NOTICES.md"
  ],
