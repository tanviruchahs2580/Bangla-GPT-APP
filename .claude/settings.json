{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npm test *)",
      "Bash(npm run test:coverage *)",
      "Bash(npm run format:check *)",
      "Bash(npm run deadcode *)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m ruff check *)",
      "Bash(.venv/Scripts/python.exe -m ruff format --check *)",
      "Bash(.venv/Scripts/python.exe -m mypy *)",
      "Bash(../../.venv/Scripts/python.exe -m pytest *)",
      "Bash(../../.venv/Scripts/python.exe -m ruff check *)",
      "Bash(../../.venv/Scripts/python.exe -m ruff format --check *)",
      "Bash(../../.venv/Scripts/python.exe -m mypy *)",
      "Bash(.venv/Scripts/lint-imports *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git * push *)",
      "Bash(git filter-repo *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git branch --delete *)",
      "Bash(git branch -m *)",
      "Bash(git branch -M *)",
      "Bash(git * --output*)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(* -m alembic revision *)",
      "Bash(* -m alembic upgrade *)",
      "Bash(* -m alembic downgrade *)",
      "Bash(alembic revision *)",
      "Bash(alembic upgrade *)",
      "Bash(alembic downgrade *)",
      "PowerShell(git push *)",
      "PowerShell(git * push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh release *)",
      "PowerShell(gh api *)",
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Edit(//**/apps/api/constraints.txt)",
      "Edit(//**/apps/api/eval/baseline_*.json)",
      "Edit(//**/data/nctb/manifests/**)",
      "Edit(//**/data/nctb/retrieval_*.json)",
      "Edit(//**/data/nctb/quality_report.json)",
      "Edit(//**/CHANGELOG.md)",
      "Edit(//**/AGENTS.md)",
      "Edit(//**/apps/api/scripts/check_coverage_floors.py)",
      "Edit(//**/apps/web/vite.config.ts)",
      "Edit(//**/apps/api/alembic/versions/**)",
      "Edit(//**/.github/workflows/**)"
    ],
    "deny": [
      "Read(//**/*.db*)",
      "Read(//**/*.keystore)",
      "Read(//**/*.jks)"
    ]
  }
}
