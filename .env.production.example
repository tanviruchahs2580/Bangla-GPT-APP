# Production environment template — Bangla GPT APP
# Copy to .env (next to docker-compose.yml) and fill every required value.
# NEVER commit the filled .env.

# ── Required in production ────────────────────────────────────────────────
ENV=production

# At least 32 random characters, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Claim bindings verified on EVERY token (RFC 8725). A token minted with a
# different iss/aud pair is refused, so these must be set in production and
# must match any other service that consumes these tokens.
JWT_ISSUER=bangla-gpt-api
JWT_AUDIENCE=bangla-gpt-clients

ADMIN_EMAIL=admin@example.com
# At least 12 characters; forced rotation on first login is enabled by default.
ADMIN_PASSWORD=

# Fernet key for guardian phone encryption at rest (S5.6). Required: the app
# refuses to boot in production without it. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Rotating it invalidates existing ciphertext -- re-encrypt with the old key
# first (see docs/runbook.md). Store alongside JWT_SECRET; never commit it.
PII_ENC_KEY=
# Must stay unset/false in production: plaintext guardian-phone storage.
# The production boot gate refuses PII_ALLOW_PLAINTEXT=true (audit B-04).
PII_ALLOW_PLAINTEXT=false

DOMAIN=tutor.example.edu.bd          # used by the Caddy TLS profile
ACME_EMAIL=ops@example.edu.bd        # Let's Encrypt notifications

GRAFANA_ADMIN_PASSWORD=

# ── LLM provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                  # mock | gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite   # keep in sync with apps/api config default
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# The per-attempt timeout is derived from LLM_TIMEOUT_SECONDS and
# LLM_MAX_RETRIES so the whole retry chain finishes inside the gunicorn worker
# timeout (60s); raising these together makes the app refuse to boot.
# Offline demos only: LLM_PROVIDER=mock requires ALLOW_MOCK_LLM_IN_PRODUCTION=true.
# ALLOW_MOCK_LLM_IN_PRODUCTION=
# Hard ceiling on generated completion size (0 = no cap; key omitted from provider payload)
LLM_MAX_OUTPUT_TOKENS=2048
# F-034: monthly per-user AI budget in USD (estimated metering, see
# apps/api/src/bangla_gpt_api/services/costs.py). 0 = unlimited, which the
# production boot gate REFUSES while a billable provider is configured: a
# looping or abusive account would be bounded only by 30 requests/minute.
# 5 is a conservative starting point for a student account; measure real
# usage in /admin/ai/quality and raise deliberately. Generation stops with a
# coded 429 ai_budget_exceeded when the month's ledger reaches the cap.
AI_MONTHLY_BUDGET_USD_PER_USER=5
# GEMINI_FAST_MODEL=   # S4.2 router: model for SIMPLE routes (empty = main model serves all)
RETRIEVAL_MODE=hybrid                # S4.3: hybrid = BM25+vector RRF+rerank; bm25 = v1 baseline
# EMBEDDING_MODEL=   # S4.3: real multilingual model = staging human input; empty = local vector lane

# ── Persistence ───────────────────────────────────────────────────────────
# Default: sqlite file on the api_data volume.
# Default posture: PostgreSQL (--profile core --profile postgres). The
# boot guard refuses file SQLite with more than one worker; the template
# used to SHIP sqlite here, steering a copy-paste deploy straight into
# the posture the current outage runs in (audit F8).
DATABASE_URL=postgresql+psycopg://bgpt:CHANGE-ME@postgres:5432/bgpt
# SQLite fallback (single worker only):
# DATABASE_URL=sqlite:////data/app.db
POSTGRES_USER=bgpt
POSTGRES_PASSWORD=
POSTGRES_DB=bgpt

# Directory containing the built NCTB corpus (normalized/ + quality_report.json).
NCTB_CORPUS_DIR=
# F-016: with NCTB_CORPUS_DIR empty the tutor answers from the bundled
# synthetic sample corpus and cites it as evidence. Production refuses to
# boot that way when a billable provider (gemini/openai) is configured, so
# point NCTB_CORPUS_DIR at the built corpus. Offline demos that deliberately
# serve the sample (together with LLM_PROVIDER=mock and
# ALLOW_MOCK_LLM_IN_PRODUCTION=true) set this instead:
# ALLOW_BUNDLED_SAMPLE_CORPUS_IN_PRODUCTION=true

# ─── Auth / HTTP hardening ───────────────────────────────────────────────
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=30
# The web origin, PLUS the Capacitor app origins when the Android/iOS build
# talks to this API directly (docs/mobile_release.md): without them the
# WebView's CORS preflight is answered 400 and login fails inside the app
# while the same account works in a desktop browser (measured live,
# 2026-10-25). Drop the last two if you ship web-only.
ALLOWED_ORIGINS=https://tutor.example.edu.bd,capacitor://localhost,https://localhost
# DATA-001: 4 MB fits the wave-2 vision contract (~2 MB base64 image JSON
# per chat turn). The previous 65536 413'd every chat turn that attached a
# photo; compose ships the same value (docker-compose.yml).
MAX_BODY_BYTES=4000000

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=30
RATE_LIMIT_TUTOR_IP_PER_MINUTE=60
RATE_LIMIT_BACKEND=redis             # memory | redis
RATE_LIMIT_FAIL_OPEN=false
REDIS_URL=redis://redis:6379/0
# S-001: true is the shipped default AND safe here because the bundled Caddy
# OVERWRITES X-Forwarded-For with the address it observed
# (`header_up X-Forwarded-For {remote_host}`); the limiter reads only the LAST
# valid XFF entry. If you front the API with another proxy, either make it
# overwrite the header too, or set this false — an appending proxy plus this
# flag lets a caller choose its own rate-limit bucket. Non-IP entries are
# ignored and the transport peer is used instead.
# apps/api/scripts/check_proxy_contract.py fails CI if this template, the
# compose default and the Caddy override ever drift apart.
TRUST_PROXY_HEADERS=true
# arq = web workers stop scheduling; run ONE `docker compose --profile worker`
# instance instead. inline is also safe (job_runs dedupe), but wastes a timer.
JOBS_BACKEND=arq                       # inline | arq

# ── Chat / invites ───────────────────────────────────────────────────────
CHAT_HISTORY_MESSAGES=8
# Per-message char cap when past turns are replayed into the prompt
CHAT_HISTORY_MESSAGE_CHAR_LIMIT=2000
CHAT_RETENTION_DAYS=180
ANALYTICS_RETENTION_DAYS=180
INVITE_TTL_MINUTES=
# Legacy bare-ID parent linking (insecure; invite-code flow is the default)
ALLOW_DIRECT_PARENT_LINK=false

# ── Email delivery (password reset) ──────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=smtp.example.edu.bd
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.edu.bd

# ── Observability / ops ──────────────────────────────────────────────────
LOG_LEVEL=INFO
WEB_CONCURRENCY=2                    # uvicorn workers inside the api container
# SEC-001: /metrics is never public in production (boot refuses otherwise).
METRICS_REQUIRE_AUTH=true
METRICS_TOKEN=                       # long random bearer token for scrapers
# Prometheus reads the same token from deploy/prometheus/metrics_token
# (git-ignored). Create it with: printf '%s' "$METRICS_TOKEN" >
# deploy/prometheus/metrics_token — otherwise every scrape answers 403.
# Alertmanager delivers to this address over the SMTP_* settings above.
ALERT_EMAIL_TO=

# ── Backups (backup profile) ─────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
# Optional offsite sync command executed after each backup, e.g. rclone:
# OFFSITE_SYNC_CMD=rclone copy /backups remote:bgpt-backups
# PGBR_STANZA=bgpt                    # pgBackRest stanza (compose default)
# S5.7 corpus object storage (scripts/s3_corpus_sync.py; any S3-compatible
# endpoint -- MinIO/R2/S3). Credentials come from the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, not from this file.
S3_BUCKET=
S3_PREFIX=nctb/
# S3_ENDPOINT_URL=https://minio.internal:9000

# ── Web build-time ───────────────────────────────────────────────────────
VITE_API_BASE=/api                   # same-origin path via Caddy/nginx proxy

# ── Image tags (CD overrides these) ──────────────────────────────────────
# Pin a released tag from ghcr.io/tanviruchahs2580/bangla-gpt-app.
# `local` means "built from this checkout" and must NOT reach a
# production host (docs/runbook.md). Replace before deploy.
API_TAG=REPLACE-WITH-RELEASED-TAG
WEB_TAG=REPLACE-WITH-RELEASED-TAG

# ── API host port (compose only; not read by the app) ────────────────────
# The API is published to the HOST for a tunnel or debug client running on the
# host itself. Caddy and nginx reach it as `api:8000` over the Compose network
# and ignore these. The defaults are loopback + 8000, which is also what the
# release workflow's 127.0.0.1:8000/health check depends on.
API_HOST_PORT=8000
# 0.0.0.0 exposes the API to the network. Nothing authenticates a client at
# that layer, so leave it on loopback unless a remote tunnel forces otherwise.
API_HOST_BIND=127.0.0.1

# Error tracking (optional; both apps init Sentry when set).
# Sentinels are stripped from logs either way.
SENTRY_DSN=
