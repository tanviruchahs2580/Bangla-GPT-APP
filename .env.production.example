# Production environment template — Bangla GPT APP
# Copy to .env (next to docker-compose.yml) and fill every required value.
# NEVER commit the filled .env.

# ── Required in production ────────────────────────────────────────────────
ENV=production

# At least 32 random characters, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
# At least 12 characters; forced rotation on first login is enabled by default.
ADMIN_PASSWORD=

# Fernet key for guardian phone encryption at rest (S5.6). Required: the app
# refuses to boot in production without it. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Rotating it invalidates existing ciphertext -- re-encrypt with the old key
# first (see docs/runbook.md). Store alongside JWT_SECRET; never commit it.
PII_ENC_KEY=

DOMAIN=tutor.example.edu.bd          # used by the Caddy TLS profile
ACME_EMAIL=ops@example.edu.bd        # Let's Encrypt notifications

GRAFANA_ADMIN_PASSWORD=

# ── LLM provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                  # mock | gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite   # keep in sync with apps/api config default
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# GEMINI_FAST_MODEL=   # S4.2 router: model for SIMPLE routes (empty = main model serves all)
RETRIEVAL_MODE=hybrid                # S4.3: hybrid = BM25+vector RRF+rerank; bm25 = v1 baseline
# EMBEDDING_MODEL=   # S4.3: real multilingual model = staging human input; empty = local vector lane

# ── Persistence ───────────────────────────────────────────────────────────
# Default: sqlite file on the api_data volume.
DATABASE_URL=sqlite:////data/app.db
# Postgres profile: uncomment and start with --profile postgres
# DATABASE_URL=postgresql+psycopg://bgpt:CHANGE-ME@postgres:5432/bgpt
POSTGRES_USER=bgpt
POSTGRES_PASSWORD=
POSTGRES_DB=bgpt

# Directory containing the built NCTB corpus (normalized/ + quality_report.json).
NCTB_CORPUS_DIR=

# ─── Auth / HTTP hardening ───────────────────────────────────────────────
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=30
ALLOWED_ORIGINS=https://tutor.example.edu.bd
MAX_BODY_BYTES=65536

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=30
RATE_LIMIT_TUTOR_IP_PER_MINUTE=60
RATE_LIMIT_BACKEND=redis             # memory | redis
RATE_LIMIT_FAIL_OPEN=false
REDIS_URL=redis://redis:6379/0
# arq = web workers stop scheduling; run ONE `docker compose --profile worker`
# instance instead. inline is also safe (job_runs dedupe), but wastes a timer.
JOBS_BACKEND=arq                       # inline | arq

# ── Chat / invites ───────────────────────────────────────────────────────
CHAT_HISTORY_MESSAGES=8
CHAT_RETENTION_DAYS=180
INVITE_TTL_MINUTES=
# Legacy bare-ID parent linking (insecure; invite-code flow is the default)
ALLOW_DIRECT_PARENT_LINK=false

# ── Email delivery (password reset) ──────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=smtp.example.edu.bd
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.edu.bd

# ── Observability / ops ──────────────────────────────────────────────────
LOG_LEVEL=INFO
WEB_CONCURRENCY=2                    # uvicorn workers inside the api container
# SEC-001: /metrics is never public in production (boot refuses otherwise).
METRICS_REQUIRE_AUTH=true
METRICS_TOKEN=                       # long random bearer token for scrapers

# ── Backups (backup profile) ─────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
# Optional offsite sync command executed after each backup, e.g. rclone:
# OFFSITE_SYNC_CMD=rclone copy /backups remote:bgpt-backups
# PGBR_STANZA=bgpt                    # pgBackRest stanza (compose default)
# S5.7 corpus object storage (scripts/s3_corpus_sync.py; any S3-compatible
# endpoint -- MinIO/R2/S3). Credentials come from the standard
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars, not from this file.
S3_BUCKET=
S3_PREFIX=nctb/
# S3_ENDPOINT_URL=https://minio.internal:9000

# ── Web build-time ───────────────────────────────────────────────────────
VITE_API_BASE=/api                   # same-origin path via Caddy/nginx proxy

# ── Image tags (CD overrides these) ──────────────────────────────────────
API_TAG=local
WEB_TAG=local
