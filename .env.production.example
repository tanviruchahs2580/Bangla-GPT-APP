# Production environment template — Bangla GPT APP
# Copy to .env (next to docker-compose.yml) and fill every required value.
# NEVER commit the filled .env.

# ── Required in production ────────────────────────────────────────────────
ENV=production

# At least 32 random characters, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
# At least 12 characters; forced rotation on first login is enabled by default.
ADMIN_PASSWORD=

DOMAIN=tutor.example.edu.bd          # used by the Caddy TLS profile
ACME_EMAIL=ops@example.edu.bd        # Let's Encrypt notifications

GRAFANA_ADMIN_PASSWORD=

# ── LLM provider ──────────────────────────────────────────────────────────
LLM_PROVIDER=gemini                  # mock | gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite   # keep in sync with apps/api config default
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ── Persistence ───────────────────────────────────────────────────────────
# Default: sqlite file on the api_data volume.
DATABASE_URL=sqlite:////data/app.db
# Postgres profile: uncomment and start with --profile postgres
# DATABASE_URL=postgresql+psycopg://bgpt:CHANGE-ME@postgres:5432/bgpt
POSTGRES_USER=bgpt
POSTGRES_PASSWORD=
POSTGRES_DB=bgpt

# Directory containing the built NCTB corpus (normalized/ + quality_report.json).
NCTB_CORPUS_DIR=

# ─── Auth / HTTP hardening ───────────────────────────────────────────────
JWT_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_MINUTES=30
ALLOWED_ORIGINS=https://tutor.example.edu.bd
MAX_BODY_BYTES=65536

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_TUTOR_PER_MINUTE=30
RATE_LIMIT_TUTOR_IP_PER_MINUTE=60
RATE_LIMIT_BACKEND=redis             # memory | redis
RATE_LIMIT_FAIL_OPEN=false
REDIS_URL=redis://redis:6379/0

# ── Chat / invites ───────────────────────────────────────────────────────
CHAT_HISTORY_MESSAGES=8
CHAT_RETENTION_DAYS=180
INVITE_TTL_MINUTES=
# Legacy bare-ID parent linking (insecure; invite-code flow is the default)
ALLOW_DIRECT_PARENT_LINK=false1440

# ── Email delivery (password reset) ──────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=smtp.example.edu.bd
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.edu.bd

# ── Observability / ops ──────────────────────────────────────────────────
LOG_LEVEL=INFO
WEB_CONCURRENCY=2                    # uvicorn workers inside the api container

# ── Backups (backup profile) ─────────────────────────────────────────────
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
# Optional offsite sync command executed after each backup, e.g. rclone:
# OFFSITE_SYNC_CMD=rclone copy /backups remote:bgpt-backups

# ── Web build-time ───────────────────────────────────────────────────────
VITE_API_BASE=/api                   # same-origin path via Caddy/nginx proxy

# ── Image tags (CD overrides these) ──────────────────────────────────────
API_TAG=local
WEB_TAG=local
