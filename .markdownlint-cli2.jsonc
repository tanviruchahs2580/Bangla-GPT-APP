{
  // markdownlint-cli2 configuration for the guardrails job.
  //
  // The default ruleset reports two style classes this repository does not
  // follow anywhere: MD013 (80-column lines, while README tables and the
  // runbook carry long unbroken table rows and URLs) and MD060 (table pipe
  // spacing style, purely cosmetic). Both are disabled with this reason.
  // Everything else is on: heading structure, list indentation, fence
  // languages, bare URLs, broken in-document anchors and duplicate headings
  // are the classes that actually mislead a reader.
  "config": {
    "MD013": false,
    "MD060": false
  },
  "globs": ["docs/**/*.md", "README.md", "CONTRIBUTING.md", "SECURITY.md"],
  "ignores": ["docs/archive/**", "node_modules/**", ".venv/**", ".qa-work/**"]
}
