# Release signing template -- copy to keystore.properties (gitignored) and fill in.
#
#   cp keystore.properties.example keystore.properties
#
# Generate the keystore ONCE, keep it out of the repo and backed up (losing it
# means losing the ability to update the app on Play unless Play App Signing
# holds the upload key rotation path):
#
#   keytool -genkeypair -v -keystore banglagpt-upload.jks -alias banglagpt \
#       -keyalg RSA -keysize 4096 -validity 10000
#
# Then set storeFile to the keystore path. Paths are resolved by Gradle, so a
# relative path is relative to apps/web/android/app (use an absolute path if in
# doubt). IN CI the same four values come from secrets via environment
# variables -- see .github/workflows/android-release.yml.
storeFile=/absolute/path/to/banglagpt-upload.jks
storePassword=change-me
keyAlias=banglagpt
keyPassword=change-me
