{
  "name": "Bangla GPT APP",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1.7.1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/github-cli:1.0.8": {}
  },
  "postCreateCommand": "bash -lc 'command -v make >/dev/null 2>&1 || { sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends make; }; make setup'",
  "forwardPorts": [8000, 5173, 5432],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "editor.formatOnSave": false
      }
    }
  },
  "remoteUser": "vscode"
}
