{
  "title": "Bangla GPT — API Overview (S0.6)",
  "uid": "bgpt-api-overview",
  "panels": [
    {
      "title": "p95 Latency (by route)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(bgpt_http_request_duration_seconds_bucket[5m])) by (le, path))"
        }
      ]
    },
    {
      "title": "Error Rate (5xx)",
      "targets": [
        {
          "expr": "sum(rate(bgpt_http_requests_total{status=~\"5..\"}[5m])) / sum(rate(bgpt_http_requests_total[5m]))"
        }
      ]
    },
    {
      "title": "AI Latency (provider round-trip, p95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(bgpt_provider_latency_seconds_bucket[5m])) by (le, provider))"
        }
      ]
    },
    {
      "title": "Rate Limit Hits (429, by route)",
      "targets": [
        {
          "expr": "sum(rate(bgpt_http_requests_total{status=\"429\"}[5m])) by (path)"
        }
      ]
    },
    {
      "title": "RAG Retrieval p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(bgpt_rag_retrieval_latency_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "title": "Grounding Gate Outcomes",
      "targets": [
        {
          "expr": "sum(rate(bgpt_rag_gate_outcomes_total[5m])) by (gate)"
        }
      ]
    },
    {
      "title": "Index Chunks (by corpus)",
      "targets": [{ "expr": "bgpt_rag_index_chunks" }]
    }
  ]
}
