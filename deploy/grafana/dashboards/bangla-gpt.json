{
  "title": "Bangla GPT — API Overview (S0.6)",
  "panels": [
    {
      "title": "p95 Latency (by route)",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(bgpt_http_request_duration_seconds_bucket[5m])) by (le, path))" }]
    },
    {
      "title": "Error Rate (5xx)",
      "targets": [{ "expr": "sum(rate(bgpt_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(bgpt_http_requests_total[5m])), 0.001)" }]
    },
    {
      "title": "Tutor retrieval latency (p95)",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(bgpt_rag_retrieval_latency_seconds_bucket[5m])) by (le))" }]
    },
    {
      "title": "Rate Limit Hits",
      "targets": [{ "expr": "sum(rate(bgpt_http_requests_total{status=\"429\"}[5m])) by (path)" }]
    }
  ]
}
